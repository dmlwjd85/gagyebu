rules_version = '2';
// 가계부 보안 규칙: 본인(users/{uid}) 데이터만 읽기·쓰기, 그 외 전부 거부.
// 공용 경로 와일드카드 쓰기 금지. 모든 쓰기는 필드 목록·형식·크기 검증.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function d() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(k, max) { return !(k in d()) || str(d()[k], 0, max); }
    function optInt(k, min, max) { return !(k in d()) || (d()[k] is int && d()[k] >= min && d()[k] <= max); }
    function optBool(k) { return !(k in d()) || d()[k] is bool; }
    function optTs(k) { return !(k in d()) || d()[k] is timestamp; }

    // 사용자 설정 문서
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['displayName', 'currency', 'monthStartDay', 'createdAt', 'updatedAt', 'seeded'])
        && optStr('displayName', 100)
        && (!('currency' in d()) || d().currency == 'KRW')
        && optInt('monthStartDay', 1, 28)
        && optBool('seeded') && optTs('createdAt') && optTs('updatedAt');

      // 거래: 금액은 1원 ~ 10억 원 정수
      match /transactions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['date', 'amount', 'kind', 'categoryId'])
          && d().keys().hasOnly(['date', 'amount', 'kind', 'categoryId', 'accountId', 'memo', 'tags', 'createdAt', 'updatedAt',
                                 'importHash', 'importBatch', 'recurringId', 'card4'])
          && d().amount is int && d().amount > 0 && d().amount <= 1000000000
          && d().kind in ['expense', 'income']
          && d().date is string && d().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && str(d().categoryId, 1, 64)
          && optStr('accountId', 64) && optStr('memo', 200)
          && (!('tags' in d()) || (d().tags is list && d().tags.size() <= 20))
          // 가져오기 지문(16자리 hex)·묶음 id·반복 id. 카드번호는 끝 4자리 숫자만 허용
          && (!('importHash' in d()) || (d().importHash is string && d().importHash.matches('^[0-9a-f]{16}$')))
          && optStr('importBatch', 40) && optStr('recurringId', 64)
          && (!('card4' in d()) || (d().card4 is string && d().card4.matches('^[0-9]{4}$')))
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 카테고리
      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['name', 'emoji', 'kind'])
          && d().keys().hasOnly(['name', 'emoji', 'kind', 'order', 'archived', 'budget'])
          && str(d().name, 1, 20) && str(d().emoji, 1, 16)
          && d().kind in ['expense', 'income']
          && optInt('order', 0, 1000) && optBool('archived') && optInt('budget', 0, 100000000000);
      }

      // 결제수단 (카드·계좌번호 저장 금지: 이름 20자 제한)
      match /accounts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['name', 'type'])
          && d().keys().hasOnly(['name', 'type', 'emoji', 'archived', 'order'])
          && str(d().name, 1, 20) && d().type in ['cash', 'card', 'bank']
          && optStr('emoji', 16) && optBool('archived') && optInt('order', 0, 1000);
      }

      // 월 예산: 문서 id = YYYY-MM
      match /budgets/{ym} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d().keys().hasAll(['total'])
          && d().keys().hasOnly(['total', 'byCategory', 'updatedAt'])
          && d().total is int && d().total >= 0 && d().total <= 100000000000
          && (!('byCategory' in d()) || (d().byCategory is map && d().byCategory.size() <= 100))
          && optTs('updatedAt');
      }

      // 자동 분류 규칙: 가맹점 글자 → 카테고리
      match /rules/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['match', 'categoryId'])
          && d().keys().hasOnly(['match', 'field', 'categoryId', 'createdAt', 'updatedAt'])
          && str(d().match, 1, 40) && str(d().categoryId, 1, 64)
          && (!('field' in d()) || d().field == 'memo')
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 반복 거래(월세·구독): 매달 dayOfMonth일에 자동 기록
      match /recurring/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['name', 'amount', 'kind', 'categoryId', 'dayOfMonth', 'active', 'startYm'])
          && d().keys().hasOnly(['name', 'amount', 'kind', 'categoryId', 'accountId', 'dayOfMonth', 'active', 'startYm', 'lastPosted', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 30)
          && d().amount is int && d().amount > 0 && d().amount <= 1000000000
          && d().kind in ['expense', 'income'] && str(d().categoryId, 1, 64) && optStr('accountId', 64)
          && d().dayOfMonth is int && d().dayOfMonth >= 1 && d().dayOfMonth <= 31
          && d().active is bool
          && d().startYm is string && d().startYm.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && (!('lastPosted' in d()) || (d().lastPosted is string && d().lastPosted.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 저축 목표: 목표 금액(1원~100억)·모은 금액(0 이상 정수)
      match /goals/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && d().keys().hasAll(['name', 'target', 'saved'])
          && d().keys().hasOnly(['name', 'emoji', 'target', 'saved', 'due', 'order', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 30) && optStr('emoji', 16)
          && d().target is int && d().target > 0 && d().target <= 10000000000
          && d().saved is int && d().saved >= 0 && d().saved <= 10000000000
          && (!('due' in d()) || (d().due is string && d().due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && optInt('order', 0, 1000) && optTs('createdAt') && optTs('updatedAt');
      }
      // 그 밖의 하위 컬렉션: 규칙 없음 = 거부
    }
    // users 밖 모든 경로: 규칙 없음 = 거부
  }
}
