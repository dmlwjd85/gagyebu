rules_version = '2';
// 가계부 보안 규칙: 본인(users/{uid}) 데이터만 읽기·쓰기, 그 외 전부 거부.
// 공용 경로 와일드카드 쓰기 금지. 모든 쓰기는 필드 목록·형식·크기 검증.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function d() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(k, max) { return !(k in d()) || str(d()[k], 0, max); }
    function optInt(k, min, max) { return !(k in d()) || (d()[k] is int && d()[k] >= min && d()[k] <= max); }
    function optBool(k) { return !(k in d()) || d()[k] is bool; }
    function optTs(k) { return !(k in d()) || d()[k] is timestamp; }
    // 실제 있는 날짜만(2026-13-45, 2026-02-30 거부). 윤년 계산 포함
    function leap(y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }
    function mdays(y, m) { return m == 2 ? (leap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31); }
    function ymd(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(v[8:10]) <= mdays(int(v[0:4]), int(v[5:7]));
    }
    function ym(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'); }
    // id 형식(필드 값·대부분의 문서 경로): Firestore 자동 id(영문·숫자 20자)·짧은 영문 id('food'),
    // 또는 소문자 낱말을 하이픈으로 이은 기본 id('etc-in').
    // 카드번호 1차 방어는 앱이 끝 4자리만 저장하는 것(card4). 규칙의 2차 방어:
    //   - 숫자 13개 이상(사이가 비어 있거나 영문·밑줄만 있어도) → 거부
    //     예: '1234567890123', '1234_5678_9012_3456', '1234a5678b9012c3456'
    //   - 공백·점·하이픈(숫자 끼움)·쉼표·슬래시 등은 위 문자 집합에 없어 형식에서 이미 거부
    // 한계: 영문·숫자가 비슷하게 섞인 20자(자동 id와 비슷)는 막을 수 없음. 자동 id에 숫자 13개 이상일 확률은 극히 낮음.
    function looksLikeCard(v) {
      return v.matches('.*([0-9][A-Za-z_]*){12}[0-9].*');
    }
    function id(v) {
      return v is string && ((v.matches('^[A-Za-z0-9_]{1,64}$') && !looksLikeCard(v)) || v.matches('^[a-z]{1,20}(-[a-z]{1,20}){1,3}$'));
    }
    // 반복 거래 자동 기록 문서 id: 'rec-' + 유효한 반복 id + '-' + YYYY-MM (src/lib/recurring.js recTxId)
    // 앞 4글자('rec-')와 뒤 8글자('-YYYY-MM')를 떼면 가운데가 반복 문서 id. 앱이 이미 쓰는 형식이라 바꾸지 않음.
    function isRecTxId(v) {
      return v is string && v.size() >= 12 && v.size() <= 80
        && v.matches('^rec-.+-[0-9]{4}-(0[1-9]|1[0-2])$')
        && id(v[4:v.size() - 8]);
    }
    // 거래 문서 경로 id: 일반 id 또는 반복 자동 기록 id
    function txDocId(v) { return id(v) || isRecTxId(v); }
    // 태그 20개·각 1~20자 문자열. join 한 번으로 전체 검사(숫자 원소는 칸별로 거부, 줄바꿈 금지)
    function tagsOk(t) {
      return t is list && t.size() <= 20
        && (t.size() == 0 || (t.join('\n').matches('^[^\n]{1,20}(\n[^\n]{1,20})*$') && t.join('\n').split('\n').size() == t.size()))
        && tagStr(t, t.size());
    }
    function tagStr(t, n) {
      return (n <= 0 || t[0] is string) && (n <= 1 || t[1] is string) && (n <= 2 || t[2] is string) && (n <= 3 || t[3] is string) && (n <= 4 || t[4] is string)
        && (n <= 5 || t[5] is string) && (n <= 6 || t[6] is string) && (n <= 7 || t[7] is string) && (n <= 8 || t[8] is string) && (n <= 9 || t[9] is string)
        && (n <= 10 || t[10] is string) && (n <= 11 || t[11] is string) && (n <= 12 || t[12] is string) && (n <= 13 || t[13] is string) && (n <= 14 || t[14] is string)
        && (n <= 15 || t[15] is string) && (n <= 16 || t[16] is string) && (n <= 17 || t[17] is string) && (n <= 18 || t[18] is string) && (n <= 19 || t[19] is string);
    }
    // 카테고리별 예산: 카테고리 30개까지(규칙 식 1000개 한도), 키는 id 형식(join 한 번으로 검사), 값은 0원 ~ 100억 원 정수.
    // 키 안에 쉼표가 있으면 join 뒤 조각 수가 키 수보다 많아짐 → 거부('1234,5678,9012,3456' 한 키가 네 키처럼 통과하던 틈)
    // 카드번호 모양: 밑줄로 이은 것 + 영문으로 이은 것(쉼표 join이라 키 경계를 넘지 않음). 규칙 식 한도 때문에 칸마다 id()는 안 씀.
    // 규칙 언어에 반복문이 없어 값은 칸 번호로 하나씩 검사
    function limitsOk(m) {
      return m is map && m.size() <= 30
        && (m.size() == 0 || (m.keys().join(',').matches('^([A-Za-z0-9_]{1,64}|[a-z]{1,20}(-[a-z]{1,20}){1,3})(,([A-Za-z0-9_]{1,64}|[a-z]{1,20}(-[a-z]{1,20}){1,3}))*$')
            && m.keys().join(',').split(',').size() == m.size()
            && !m.keys().join(',').matches('.*([0-9]_*){12}[0-9].*')
            && !m.keys().join(',').matches('.*([0-9][A-Za-z]*){12}[0-9].*')))
        && limVals(m.values(), m.size());
    }
    function limVals(v, n) {
      return (n <= 0 || (v[0] is int && v[0] >= 0 && v[0] <= 10000000000)) && (n <= 1 || (v[1] is int && v[1] >= 0 && v[1] <= 10000000000)) && (n <= 2 || (v[2] is int && v[2] >= 0 && v[2] <= 10000000000))
        && (n <= 3 || (v[3] is int && v[3] >= 0 && v[3] <= 10000000000)) && (n <= 4 || (v[4] is int && v[4] >= 0 && v[4] <= 10000000000)) && (n <= 5 || (v[5] is int && v[5] >= 0 && v[5] <= 10000000000))
        && (n <= 6 || (v[6] is int && v[6] >= 0 && v[6] <= 10000000000)) && (n <= 7 || (v[7] is int && v[7] >= 0 && v[7] <= 10000000000)) && (n <= 8 || (v[8] is int && v[8] >= 0 && v[8] <= 10000000000))
        && (n <= 9 || (v[9] is int && v[9] >= 0 && v[9] <= 10000000000)) && (n <= 10 || (v[10] is int && v[10] >= 0 && v[10] <= 10000000000)) && (n <= 11 || (v[11] is int && v[11] >= 0 && v[11] <= 10000000000))
        && (n <= 12 || (v[12] is int && v[12] >= 0 && v[12] <= 10000000000)) && (n <= 13 || (v[13] is int && v[13] >= 0 && v[13] <= 10000000000)) && (n <= 14 || (v[14] is int && v[14] >= 0 && v[14] <= 10000000000))
        && (n <= 15 || (v[15] is int && v[15] >= 0 && v[15] <= 10000000000)) && (n <= 16 || (v[16] is int && v[16] >= 0 && v[16] <= 10000000000)) && (n <= 17 || (v[17] is int && v[17] >= 0 && v[17] <= 10000000000))
        && (n <= 18 || (v[18] is int && v[18] >= 0 && v[18] <= 10000000000)) && (n <= 19 || (v[19] is int && v[19] >= 0 && v[19] <= 10000000000)) && (n <= 20 || (v[20] is int && v[20] >= 0 && v[20] <= 10000000000))
        && (n <= 21 || (v[21] is int && v[21] >= 0 && v[21] <= 10000000000)) && (n <= 22 || (v[22] is int && v[22] >= 0 && v[22] <= 10000000000)) && (n <= 23 || (v[23] is int && v[23] >= 0 && v[23] <= 10000000000))
        && (n <= 24 || (v[24] is int && v[24] >= 0 && v[24] <= 10000000000)) && (n <= 25 || (v[25] is int && v[25] >= 0 && v[25] <= 10000000000)) && (n <= 26 || (v[26] is int && v[26] >= 0 && v[26] <= 10000000000))
        && (n <= 27 || (v[27] is int && v[27] >= 0 && v[27] <= 10000000000)) && (n <= 28 || (v[28] is int && v[28] >= 0 && v[28] <= 10000000000)) && (n <= 29 || (v[29] is int && v[29] >= 0 && v[29] <= 10000000000));
    }
    // 가져오기 묶음 id: 'imp-' + 시각(36진수 6~12자). 12자 넘는 숫자열(카드번호 모양)은 못 들어감
    function batchId(v) { return v is string && v.matches('^imp-[0-9a-z]{6,12}$'); }
    // 계좌번호(숫자 10개 이상)는 기관·이름에 넣지 않음
    function noAcctNo(v) { return !v.matches('.*[0-9]{10}.*'); }
    // 쓰는 방식. 키는 고정, 값은 불리언만. 테마 같은 다른 키는 거부.
    function featuresOk(m) {
      return m is map && m.size() <= 10
        && m.keys().hasOnly(['recurring', 'monthStart', 'weekDaily', 'sms', 'allowance', 'piggy', 'categoryLimits', 'studentIncome', 'monthShare', 'txOwner'])
        && (!('recurring' in m) || m.recurring is bool)
        && (!('monthStart' in m) || m.monthStart is bool)
        && (!('weekDaily' in m) || m.weekDaily is bool)
        && (!('sms' in m) || m.sms is bool)
        && (!('allowance' in m) || m.allowance is bool)
        && (!('piggy' in m) || m.piggy is bool)
        && (!('categoryLimits' in m) || m.categoryLimits is bool)
        && (!('studentIncome' in m) || m.studentIncome is bool)
        && (!('monthShare' in m) || m.monthShare is bool)
        && (!('txOwner' in m) || m.txOwner is bool);
    }

    // 사용자 설정 문서
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['displayName', 'currency', 'monthStartDay', 'createdAt', 'updatedAt', 'seeded'])
        && optStr('displayName', 100)
        && (!('currency' in d()) || d().currency == 'KRW')
        && optInt('monthStartDay', 1, 28)
        && optBool('seeded') && optTs('createdAt') && optTs('updatedAt');

      // 거래: 금액은 1원 ~ 10억 원 정수. 음수는 카드 환불(지출 차감)만: 가져온 지출(importHash 있음)일 때만 허용
      // 업데이트에 owner가 이미 있으면 요청에도 있어야 한다. 예전 앱의 set()은 그 칸을 몰라 통째로 지운다.
      match /transactions/{docId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && txDocId(docId) // 일반 id 또는 rec-{반복id}-{YYYY-MM}(쓰기만, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['date', 'amount', 'kind', 'categoryId'])
          && d().keys().hasOnly(['date', 'amount', 'kind', 'categoryId', 'accountId', 'memo', 'tags', 'createdAt', 'updatedAt',
                                 'importHash', 'importBatch', 'recurringId', 'card4', 'owner'])
          && d().amount is int && d().amount <= 1000000000
          && (d().amount > 0 || (d().amount < 0 && d().amount >= -1000000000 && d().kind == 'expense' && 'importHash' in d()))
          && d().kind in ['expense', 'income']
          && ymd(d().date)
          && id(d().categoryId)
          && (!('accountId' in d()) || id(d().accountId)) && optStr('memo', 200)
          && (!('tags' in d()) || tagsOk(d().tags))
          // 가져오기 지문(16자리 hex)·묶음 id·반복 id. 카드번호는 끝 4자리 숫자만 허용
          && (!('importHash' in d()) || (d().importHash is string && d().importHash.matches('^[0-9a-f]{16}$')))
          && (!('importBatch' in d()) || batchId(d().importBatch))
          && (!('recurringId' in d()) || id(d().recurringId))
          && (!('card4' in d()) || (d().card4 is string && d().card4.matches('^[0-9]{4}$')))
          && (!('owner' in d()) || d().owner in ['나', '배우자', '공동'])
          && optTs('createdAt') && optTs('updatedAt');
        allow update: if isOwner(uid)
          && txDocId(docId)
          && d().keys().hasAll(['date', 'amount', 'kind', 'categoryId'])
          && d().keys().hasOnly(['date', 'amount', 'kind', 'categoryId', 'accountId', 'memo', 'tags', 'createdAt', 'updatedAt',
                                 'importHash', 'importBatch', 'recurringId', 'card4', 'owner'])
          && d().amount is int && d().amount <= 1000000000
          && (d().amount > 0 || (d().amount < 0 && d().amount >= -1000000000 && d().kind == 'expense' && 'importHash' in d()))
          && d().kind in ['expense', 'income']
          && ymd(d().date)
          && id(d().categoryId)
          && (!('accountId' in d()) || id(d().accountId)) && optStr('memo', 200)
          && (!('tags' in d()) || tagsOk(d().tags))
          && (!('importHash' in d()) || (d().importHash is string && d().importHash.matches('^[0-9a-f]{16}$')))
          && (!('importBatch' in d()) || batchId(d().importBatch))
          && (!('recurringId' in d()) || id(d().recurringId))
          && (!('card4' in d()) || (d().card4 is string && d().card4.matches('^[0-9]{4}$')))
          && (!('owner' in d()) || d().owner in ['나', '배우자', '공동'])
          && (!('owner' in resource.data) || 'owner' in d())
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 카테고리
      match /categories/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId) // 문서 id도 같은 형식(쓰기만 검사, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['name', 'emoji', 'kind'])
          && d().keys().hasOnly(['name', 'emoji', 'kind', 'order', 'archived', 'budget'])
          && str(d().name, 1, 20) && str(d().emoji, 1, 16)
          && d().kind in ['expense', 'income']
          && optInt('order', 0, 1000) && optBool('archived') && optInt('budget', 0, 100000000000);
      }

      // 결제수단 (카드·계좌번호 저장 금지: 이름 20자 제한)
      match /accounts/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId) // 문서 id도 같은 형식(쓰기만 검사, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['name', 'type'])
          && d().keys().hasOnly(['name', 'type', 'emoji', 'archived', 'order'])
          && str(d().name, 1, 20) && d().type in ['cash', 'card', 'bank']
          && optStr('emoji', 16) && optBool('archived') && optInt('order', 0, 1000);
      }

      // 월 예산: 문서 id = YYYY-MM
      match /budgets/{ym} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d().keys().hasAll(['total'])
          && d().keys().hasOnly(['total', 'byCategory', 'updatedAt'])
          && d().total is int && d().total >= 0 && d().total <= 100000000000
          && (!('byCategory' in d()) || limitsOk(d().byCategory))
          && optTs('updatedAt');
      }

      // 자동 분류 규칙: 가맹점 글자 → 카테고리
      match /rules/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId) // 문서 id도 같은 형식(쓰기만 검사, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['match', 'categoryId'])
          && d().keys().hasOnly(['match', 'field', 'categoryId', 'createdAt', 'updatedAt'])
          && str(d().match, 1, 40) && id(d().categoryId)
          && (!('field' in d()) || d().field == 'memo')
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 반복 거래(월세·구독): 매달 dayOfMonth일에 자동 기록
      // 거래와 같이, 이미 있는 owner를 업데이트에서 빼면 거부한다.
      match /recurring/{docId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && id(docId) // 문서 id도 같은 형식(쓰기만 검사, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['name', 'amount', 'kind', 'categoryId', 'dayOfMonth', 'active', 'startYm'])
          && d().keys().hasOnly(['name', 'amount', 'kind', 'categoryId', 'accountId', 'dayOfMonth', 'active', 'startYm', 'lastPosted', 'owner', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 30)
          && d().amount is int && d().amount > 0 && d().amount <= 1000000000
          && d().kind in ['expense', 'income'] && id(d().categoryId) && (!('accountId' in d()) || id(d().accountId))
          && d().dayOfMonth is int && d().dayOfMonth >= 1 && d().dayOfMonth <= 31
          && d().active is bool
          && ym(d().startYm)
          && (!('lastPosted' in d()) || ym(d().lastPosted))
          && (!('owner' in d()) || d().owner in ['나', '배우자', '공동'])
          && optTs('createdAt') && optTs('updatedAt');
        allow update: if isOwner(uid)
          && id(docId)
          && d().keys().hasAll(['name', 'amount', 'kind', 'categoryId', 'dayOfMonth', 'active', 'startYm'])
          && d().keys().hasOnly(['name', 'amount', 'kind', 'categoryId', 'accountId', 'dayOfMonth', 'active', 'startYm', 'lastPosted', 'owner', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 30)
          && d().amount is int && d().amount > 0 && d().amount <= 1000000000
          && d().kind in ['expense', 'income'] && id(d().categoryId) && (!('accountId' in d()) || id(d().accountId))
          && d().dayOfMonth is int && d().dayOfMonth >= 1 && d().dayOfMonth <= 31
          && d().active is bool
          && ym(d().startYm)
          && (!('lastPosted' in d()) || ym(d().lastPosted))
          && (!('owner' in d()) || d().owner in ['나', '배우자', '공동'])
          && (!('owner' in resource.data) || 'owner' in d())
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 저축 목표: 목표 금액(1원~100억)·모은 금액(0 이상 정수)
      match /goals/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId) // 문서 id도 같은 형식(쓰기만 검사, 예전 문서 읽기·삭제는 그대로)
          && d().keys().hasAll(['name', 'target', 'saved'])
          && d().keys().hasOnly(['name', 'emoji', 'target', 'saved', 'due', 'order', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 30) && optStr('emoji', 16)
          && d().target is int && d().target > 0 && d().target <= 10000000000
          && d().saved is int && d().saved >= 0 && d().saved <= 10000000000
          && (!('due' in d()) || ymd(d().due))
          && optInt('order', 0, 1000) && optTs('createdAt') && optTs('updatedAt');
      }
      // 가져오기 묶음 기록(여러 묶음·다른 기기에서도 되돌리기): 문서 id = 묶음 id, 건수·기간·형식 이름만
      match /imports/{bid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && batchId(bid)
          && d().keys().hasAll(['count', 'at'])
          && d().keys().hasOnly(['count', 'from', 'to', 'label', 'at'])
          && d().count is int && d().count >= 0 && d().count <= 100000
          && (!('from' in d()) || ymd(d().from)) && (!('to' in d()) || ymd(d().to))
          && optStr('label', 20) && d().at is timestamp;
      }
      // 주식·연금 계좌. 결제수단(accounts: cash|card|bank)과 다른 컬렉션이라 기존 결제수단 형식은 그대로.
      match /assetAccounts/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId)
          && d().keys().hasAll(['type', 'institution', 'name', 'opened'])
          && d().keys().hasOnly(['type', 'institution', 'name', 'opened', 'maturity', 'expectedPension', 'order', 'archived', 'createdAt', 'updatedAt'])
          && d().type in ['stock', 'pension', 'irp', 'isa', 'dc', 'civil']
          && str(d().institution, 1, 40) && noAcctNo(d().institution)
          && str(d().name, 1, 40) && noAcctNo(d().name)
          && ymd(d().opened)
          && (!('maturity' in d()) || ymd(d().maturity))
          && optInt('expectedPension', 0, 10000000000)
          && optInt('order', 0, 1000) && optBool('archived')
          && optTs('createdAt') && optTs('updatedAt');
      }
      // 보유. qtyE4 = 수량 × 10000(소수 넷째 자리). 시세는 종가·기준일만.
      match /holdings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId)
          && d().keys().hasAll(['assetAccountId', 'name', 'kind', 'qtyE4', 'avgPrice'])
          && d().keys().hasOnly(['assetAccountId', 'code', 'name', 'kind', 'qtyE4', 'avgPrice', 'lastPrice', 'priceDate', 'priceSource', 'createdAt', 'updatedAt'])
          && id(d().assetAccountId)
          && str(d().name, 1, 80) && noAcctNo(d().name)
          && (!('code' in d()) || (d().code is string && d().code.matches('^[A-Za-z0-9]{1,12}$')))
          && d().kind in ['stock', 'etf', 'fund', 'deposit']
          && ((d().kind != 'stock' && d().kind != 'etf') || ('code' in d() && d().code.matches('^[A-Za-z0-9]{1,12}$')))
          && d().qtyE4 is int && d().qtyE4 > 0 && d().qtyE4 <= 1000000000000
          && d().avgPrice is int && d().avgPrice >= 0 && d().avgPrice <= 10000000000
          && optInt('lastPrice', 0, 10000000000)
          && (!('priceDate' in d()) || ymd(d().priceDate))
          && (!('priceSource' in d()) || d().priceSource in ['manual', 'dataGoKr'])
          && optTs('createdAt') && optTs('updatedAt');
      }
      match /contributions/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id(docId)
          && d().keys().hasAll(['assetAccountId', 'date', 'amount', 'deductible'])
          && d().keys().hasOnly(['assetAccountId', 'date', 'amount', 'deductible', 'createdAt', 'updatedAt'])
          && id(d().assetAccountId)
          && ymd(d().date)
          && d().amount is int && d().amount > 0 && d().amount <= 10000000000
          && d().deductible is bool
          && optTs('createdAt') && optTs('updatedAt');
      }
      // 세액공제 한도·세율. 문서 id는 tax 하나.
      match /assetPrefs/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'tax'
          && d().keys().hasAll(['pensionLimit', 'combinedLimit', 'rateHigh', 'rateLow', 'rateChoice'])
          && d().keys().hasOnly(['pensionLimit', 'combinedLimit', 'rateHigh', 'rateLow', 'rateChoice', 'updatedAt'])
          && d().pensionLimit is int && d().pensionLimit >= 0 && d().pensionLimit <= 100000000000
          && d().combinedLimit is int && d().combinedLimit >= 0 && d().combinedLimit <= 100000000000
          && d().rateHigh is int && d().rateHigh >= 0 && d().rateHigh <= 10000
          && d().rateLow is int && d().rateLow >= 0 && d().rateLow <= 10000
          && d().rateChoice in ['high', 'low']
          && optTs('updatedAt');
      }
      // 쓰는 방식(1인 가구·부부·학생). 문서 id는 prefs 하나. 없어도 기존 화면은 그대로.
      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'prefs'
          && d().keys().hasOnly(['mode', 'askMode', 'features', 'allowanceAmount', 'allowanceCycle', 'allowanceWeekday', 'allowanceDay', 'spouseName', 'splitMe', 'updatedAt'])
          && (!('mode' in d()) || d().mode in ['single', 'couple', 'student'])
          && optBool('askMode')
          && (!('features' in d()) || featuresOk(d().features))
          && optInt('allowanceAmount', 0, 10000000000)
          && (!('allowanceCycle' in d()) || d().allowanceCycle in ['week', 'month'])
          && optInt('allowanceWeekday', 0, 6)
          && optInt('allowanceDay', 1, 28)
          && (!('spouseName' in d()) || str(d().spouseName, 1, 20))
          && optInt('splitMe', 0, 100)
          && optTs('updatedAt');
      }
      // 그 밖의 하위 컬렉션: 규칙 없음 = 거부
    }
    // users 밖 모든 경로: 규칙 없음 = 거부
  }
}
